# AT Gateway Configuration
# CONFIG_PATH=config.yml

## Serial port
MODEM__PORT=/dev/ttyUSB0
MODEM__BAUD_RATE=115200

## HTTP server
HTTP__ADDRESS=127.0.0.1:3000

## SQLite database
DATABASE__URL=sqlite://data/gateway.db

## Messages worker
# Background queue poll interval (default: 1s)
MESSAGES__POLL_INTERVAL=1s
# Device ID stamped on sent messages (default: default)
MESSAGES__DEVICE_ID=default
# Maximum number of concatenated SMS parts a text may be split into
# (default: 10; 0 disables the cap, the 255-part protocol ceiling always
# applies)
MESSAGES__MAX_SEGMENTS=10
# ISO 3166-1 alpha-2 country code used to parse phone numbers without an
# international prefix during E.164 validation (default: RU)
MESSAGES__DEFAULT_REGION=RU

# Actions
AWS_REGION=
AWS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_ENDPOINT=