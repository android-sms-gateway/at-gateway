# AT Gateway Configuration
# CONFIG_PATH=config.yml

## Serial port
MODEM__PORT=/dev/ttyUSB0
MODEM__BAUD_RATE=115200

## Modem message store
# Total number of attempts (not the retries after the first) to delete a read
# store entry with AT+CMGD; every attempt additionally waits up to the modem
# command timeout, so 3 attempts at a 30s timeout can hold a slot for ~96s
# (default: 3)
MODEM__CMGD__RETRY_ATTEMPTS=3
# Base delay between those attempts, applied exponentially (2s, 4s, ...)
# (default: 2s)
MODEM__CMGD__RETRY_BACKOFF=2s

## Modem preferred message storage (+CPMS <mem1>)
# Store the gateway reads from before the first +CMTI names one. The store a
# message was filed in is selected per operation, so this is the initial and
# sweep default (default: SM)
MODEM__STORE__MEMORY=SM
# Period of the retained-entry sweep that lists every store a message can be
# filed in with AT+CMGL=4 and re-processes entries stored but never
# re-notified, so the store cannot fill (default: 60s; 0 disables the sweep)
MODEM__STORE__SWEEP_INTERVAL=60s

## HTTP server
HTTP__ADDRESS=127.0.0.1:3000

## SQLite database
DATABASE__URL=sqlite://data/gateway.db?_foreign_keys=1

## Messages worker
# Background queue poll interval (default: 1s)
MESSAGES__POLL_INTERVAL=1s
# Maximum number of concatenated SMS parts a text may be split into
# (default: 10; 0 disables the cap, the 255-part protocol ceiling always
# applies)
MESSAGES__MAX_SEGMENTS=10
# ISO 3166-1 alpha-2 country code used to parse phone numbers without an
# international prefix during E.164 validation (default: RU)
MESSAGES__DEFAULT_REGION=RU

## Inbox
# How long the parts of one multi-part received SMS may stay incomplete before
# the group is discarded and counted (default: 5m)
INBOX__REASSEMBLY_TIMEOUT=5m
# Period of the inbox reassembly/dedupe EVICTION sweep: drops incomplete
# reassembly groups past their window and forgets expired dedupe entries. This
# is NOT the modem retained-entry RECOVERY sweep, which re-reads stored modem
# entries and is documented under "Modem preferred message storage" above
# (default: 1s)
INBOX__SWEEP_INTERVAL=1s
# Age-based retention WINDOW for the stored inbox rows: each cleanup pass
# removes rows whose received stamp is older than this window. NOT a sweep:
# distinct from INBOX__SWEEP_INTERVAL (reassembly/dedupe EVICTION) and
# MODEM__STORE__SWEEP_INTERVAL (modem retained-entry RECOVERY). Numeric-hour
# form only - the duration parser accepts 720h but NOT 7d (default: 720h = 30d)
INBOX__RETENTION=720h
# Cadence of that age-based retention cleanup (default: 24h). NOT a sweep:
# distinct from INBOX__SWEEP_INTERVAL and MODEM__STORE__SWEEP_INTERVAL.
# Numeric-hour form only - the duration parser accepts 24h but NOT 1d
INBOX__CLEANUP_INTERVAL=24h

## Webhooks
# Maximum number of retries after the initial delivery (default: 15)
WEBHOOKS__RETRY_COUNT=15
# Empty means auto-generate a 32-character key and persist it to data/storage.json
WEBHOOKS__SIGNING_KEY=

## Webhooks queue
# Number of queued deliveries processed per batch (default: 20)
WEBHOOKS__QUEUE__BATCH_SIZE=20
# Maximum duration of one webhook delivery request (default: 30s)
WEBHOOKS__QUEUE__REQUEST_TIMEOUT=30s
# Maximum duration allowed to establish a webhook connection (default: 5s)
WEBHOOKS__QUEUE__DIAL_TIMEOUT=5s
# Base delay between delivery retry attempts (default: 5s)
WEBHOOKS__QUEUE__RETRY_BASE_DELAY=5s
# Delay before polling an empty queue (default: 5s)
WEBHOOKS__QUEUE__IDLE_DELAY=5s
# Maximum time an in-flight delivery may remain processing (default: 5m)
WEBHOOKS__QUEUE__STUCK_PROCESSING_TIMEOUT=5m
# Retention period for completed queue entries (default: 7d = 168h)
WEBHOOKS__QUEUE__CLEANUP_RETENTION=168h

## Ping
# Period of the system:ping heartbeat POST to every webhook registered for that
# event; the payload is an empty JSON object (default: 60s; 0 disables the event
# entirely)
PING__INTERVAL=60s

# Actions
AWS_REGION=
AWS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_ENDPOINT=