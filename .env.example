# Environment Configuration Template for at-gateway
# Copy this file to .env and fill in your actual values
# This file documents every configuration variable the gateway reads, with
# purpose, format, default and example for each
#
# Load order (later wins): CONFIG_PATH YAML file -> .env (working directory) ->
# process environment variables. Nested keys use a double underscore separator,
# e.g. MODEM__PORT maps to modem.port. Values equal to the built-in defaults
# are safe to keep as-is.
#
# Durations use Go's time.ParseDuration format (30s, 5m, 1h); the day unit is
# NOT supported - express days in hours (168h instead of 7d, 720h instead of 7d
# for 30 days)

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Optional YAML config file
# Purpose: Loads a YAML file whose keys overlay the built-in defaults before
#   .env and process environment variables are applied
# Format: File path, process environment variable only - a CONFIG_PATH line
#   inside .env is ignored (the app reads it with os.Getenv, which never sees
#   the dotenv file)
# Default: (empty, the YAML overlay is skipped)
# Example: config.yml
CONFIG_PATH=

# =============================================================================
# HTTP SERVER CONFIGURATION
# =============================================================================

# HTTP API listen address
# Purpose: Host:port the HTTP API binds to on startup
# Format: host:port
# Default: 127.0.0.1:3000
# Example: 127.0.0.1:3000
# Example: 0.0.0.0:3000
HTTP__ADDRESS=127.0.0.1:3000

# Trusted proxy header
# Purpose: Request header consulted for the real client IP when the gateway
#   runs behind a reverse proxy
# Format: HTTP header name
# Default: X-Forwarded-For
# Example: X-Real-IP
HTTP__PROXY_HEADER=X-Forwarded-For

# Trusted proxies
# Purpose: Which proxy addresses are allowed to supply the client IP header;
#   empty trusts the direct peer only
# Format: JSON array of IPs or CIDRs when set through .env or process
#   environment (a comma-separated string becomes ONE bogus list entry); YAML
#   list when set through the CONFIG_PATH file; leave commented out (or unset)
#   for the empty default - an active empty value yields a [""] list
# Default: (empty)
# Example: ["127.0.0.1"]
# Example: ["127.0.0.1", "10.0.0.0/8"]
# HTTP__PROXIES=["127.0.0.1"]

# =============================================================================
# OPENAPI / SWAGGER DOCUMENTATION
# =============================================================================

# Swagger UI toggle
# Purpose: Serves interactive Swagger UI at /api/v1/docs; disabled instances
#   serve the spec without the UI
# Format: boolean (true|false)
# Default: true
# Example: true
HTTP__OPENAPI__ENABLED=true

# Public host for Swagger
# Purpose: Overrides the host Swagger UI displays and sends requests to when
#   the gateway is addressed under a public name (reverse proxy, LAN address)
# Format: host[:port]
# Default: (empty, the generated docs host is used)
# Example: gateway.example.com:8443
HTTP__OPENAPI__PUBLIC_HOST=

# Public base path for Swagger
# Purpose: Overrides the documented base path when the gateway is served under
#   a URL path prefix in front of it
# Format: URL path
# Default: (empty, /api/v1 is used)
# Example: /api/v1
HTTP__OPENAPI__PUBLIC_PATH=

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================

# Basic auth username
# Purpose: Username of the HTTP Basic credentials required by every /api/v1
#   route; when unset the value saved in the storage file is used, otherwise
#   the built-in default
# Format: string
# Default: sms
# Example: sms
AUTH__BASIC__USERNAME=sms

# Basic auth password
# Purpose: Password of the HTTP Basic credentials; when left empty an
#   8-character password is generated on first boot and persisted to the
#   storage file (data/storage.json), then reused on later boots
# Format: string, treat as a secret - prefer setting it as a process
#   environment variable instead of committing it in .env
# Default: (empty, generated and persisted on first boot)
# Example: change-me
AUTH__BASIC__PASSWORD=

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# SQLite database URL
# Purpose: SQLite store behind the message queue, inbox, webhook registry and
#   settings; lives under the persisted data directory
# Format: SQLite DSN
# Default: sqlite://data/gateway.db?_foreign_keys=1
# Example: sqlite://data/gateway.db?_foreign_keys=1
DATABASE__URL=sqlite://data/gateway.db?_foreign_keys=1

# =============================================================================
# LOCAL STORAGE CONFIGURATION
# =============================================================================

# Local JSON storage file
# Purpose: Persists the device ID, the generated Basic auth password and the
#   generated webhook signing key between restarts; keep it on the same
#   persisted volume as the database
# Format: file path
# Default: data/storage.json
# Example: data/storage.json
STORAGE__PATH=data/storage.json

# =============================================================================
# DEVICE CONFIGURATION
# =============================================================================

# Device display name
# Purpose: Human-readable name of this gateway device, returned by
#   GET /api/v1/devices alongside the live SIM information
# Format: string
# Default: (empty)
# Example: Workshop modem
DEVICE__NAME=

# =============================================================================
# SERIAL PORT / MODEM CONFIGURATION
# =============================================================================

# Modem serial device
# Purpose: Serial device the AT-command modem is attached to; inside Docker
#   pass it through with --device
# Format: device path
# Default: /dev/ttyUSB0
# Example: /dev/ttyUSB0
# Example: /dev/ttyACM0
MODEM__PORT=/dev/ttyUSB0

# Serial baud rate
# Purpose: Baud rate used to open the modem serial port
# Format: integer
# Default: 115200
# Example: 115200
MODEM__BAUD_RATE=115200

# Modem init timeout
# Purpose: Upper bound of the boot init sequence (AT, ATE0, +CMEE=1, +CMGF=0,
#   +CNMI=2,1,0,1,0 and the +CPIN? SIM READY gate)
# Format: duration (30s, 5m, 1h)
# Default: 30s
# Example: 30s
MODEM__INIT_TIMEOUT=30s

# Modem command timeout
# Purpose: Upper bound of a single AT command round-trip, applied to every
#   modem command including the message-store deletion attempts below
# Format: duration (30s, 5m, 1h)
# Default: 30s
# Example: 30s
MODEM__COMMAND_TIMEOUT=30s

# =============================================================================
# MODEM MESSAGE STORE CONFIGURATION
# =============================================================================

# Store deletion attempts
# Purpose: Total number of AT+CMGD attempts (first attempt included) to remove
#   a read entry from the modem message store; every attempt additionally waits
#   up to the modem command timeout, so 3 attempts at a 30s timeout can hold a
#   slot for about 96 seconds; 1 disables retrying
# Format: integer (>= 1)
# Default: 3
# Example: 3
MODEM__CMGD__RETRY_ATTEMPTS=3

# Store deletion backoff
# Purpose: Base delay between the deletion attempts, applied exponentially
#   (2s, 4s, 8s, ...); the defaults (3 attempts, 2s base) spend 6s sleeping
# Format: duration (30s, 5m, 1h)
# Default: 2s
# Example: 2s
MODEM__CMGD__RETRY_BACKOFF=2s

# Preferred message storage
# Purpose: +CPMS <mem1> used before the first +CMTI names a store and as the
#   first store listed by the retained-entry sweep; every store a +CMTI has
#   named since is selected per operation and swept too
# Format: modem storage identifier
# Default: SM
# Example: SM
MODEM__STORE__MEMORY=SM

# Retained-entry sweep interval
# Purpose: Period of the retained-entry sweep that lists the store with
#   AT+CMGL=4 and re-processes entries that were stored but never
#   re-notified, so the store cannot fill up
# Format: duration (30s, 5m, 1h); 0 disables the sweep
# Default: 60s
# Example: 60s
MODEM__STORE__SWEEP_INTERVAL=60s

# =============================================================================
# MESSAGES WORKER CONFIGURATION
# =============================================================================

# Queue poll interval
# Purpose: How long the outgoing-message worker sleeps after finding an empty
#   queue before polling again
# Format: duration (30s, 5m, 1h); non-positive falls back to 1s
# Default: 1s
# Example: 1s
MESSAGES__POLL_INTERVAL=1s

# Maximum segments per message
# Purpose: Caps the number of concatenated SMS parts a text is split into;
#   texts needing more parts are rejected before any modem traffic; 0 disables
#   the cap (the 255-part protocol ceiling always applies)
# Format: integer (>= 0)
# Default: 10
# Example: 10
MESSAGES__MAX_SEGMENTS=10

# Default phone region
# Purpose: ISO 3166-1 alpha-2 country code used to parse phone numbers
#   without an international prefix during E.164 validation; empty falls back
#   to the built-in default
# Format: ISO 3166-1 alpha-2 country code
# Default: RU
# Example: RU
# Example: DE
MESSAGES__DEFAULT_REGION=RU

# =============================================================================
# INBOX CONFIGURATION (INBOUND SMS PIPELINE)
# =============================================================================

# Reassembly timeout
# Purpose: How long the parts of one multi-part received SMS may stay
#   incomplete before the group is evicted; evicted groups are never emitted
#   as partial messages
# Format: duration (30s, 5m, 1h); non-positive falls back to 5m
# Default: 5m
# Example: 5m
INBOX__REASSEMBLY_TIMEOUT=5m

# Reassembly/dedupe eviction interval
# Purpose: Cadence of the sweep that drops incomplete reassembly groups past
#   their window and forgets expired dedupe entries; distinct from
#   MODEM__STORE__SWEEP_INTERVAL, which recovers stored modem entries
# Format: duration (30s, 5m, 1h); non-positive falls back to 1s
# Default: 1s
# Example: 1s
INBOX__SWEEP_INTERVAL=1s

# Inbox retention window
# Purpose: Age-based retention of the stored inbox rows: every cleanup pass
#   removes rows whose received stamp is older than this window; NOT a sweep
#   interval - the cadence is INBOX__CLEANUP_INTERVAL; hours-only form (720h,
#   not 7d)
# Format: duration in hours (720h = 30 days)
# Default: 720h
# Example: 720h
INBOX__RETENTION=720h

# Inbox cleanup interval
# Purpose: Cadence of the age-based retention cleanup described above;
#   hours-only form (24h, not 1d)
# Format: duration in hours (24h = 1 day)
# Default: 24h
# Example: 24h
INBOX__CLEANUP_INTERVAL=24h

# =============================================================================
# WEBHOOKS CONFIGURATION
# =============================================================================

# Delivery retry count
# Purpose: Maximum number of delivery attempts after the initial one for each
#   webhook event; a value stored through the Settings API
#   (webhooks.retry_count) overrides this variable when set
# Format: integer (>= 0)
# Default: 15
# Example: 15
WEBHOOKS__RETRY_COUNT=15

# Signing key
# Purpose: HMAC-SHA256 key for the X-Signature request header, computed over
#   payload and X-Timestamp; empty falls back to the key saved through the
#   Settings API (write-only, webhooks.signing_key), then to the key stored in
#   the storage file, and finally a 32-character key is generated and persisted
#   to the storage file on first delivery
# Format: string, treat as a secret - prefer setting it as a process
#   environment variable instead of committing it in .env
# Default: (empty, generated and persisted on first delivery)
# Example: change-me-to-a-long-random-string
WEBHOOKS__SIGNING_KEY=

# =============================================================================
# WEBHOOKS QUEUE WORKER CONFIGURATION
# =============================================================================

# Queue batch size
# Purpose: Number of queued deliveries processed per queue pass
# Format: integer (>= 1)
# Default: 20
# Example: 20
WEBHOOKS__QUEUE__BATCH_SIZE=20

# Delivery request timeout
# Purpose: Maximum duration of one webhook delivery HTTP request
# Format: duration (30s, 5m, 1h)
# Default: 30s
# Example: 30s
WEBHOOKS__QUEUE__REQUEST_TIMEOUT=30s

# Dial timeout
# Purpose: Maximum duration allowed to establish the webhook connection
# Format: duration (30s, 5m, 1h)
# Default: 5s
# Example: 5s
WEBHOOKS__QUEUE__DIAL_TIMEOUT=5s

# Retry base delay
# Purpose: Base delay between delivery retry attempts, applied exponentially
# Format: duration (30s, 5m, 1h)
# Default: 5s
# Example: 5s
WEBHOOKS__QUEUE__RETRY_BASE_DELAY=5s

# Idle delay
# Purpose: Delay before polling the queue again when it is empty
# Format: duration (30s, 5m, 1h)
# Default: 5s
# Example: 5s
WEBHOOKS__QUEUE__IDLE_DELAY=5s

# Stuck processing timeout
# Purpose: Maximum time an in-flight delivery may remain claimed before the
#   recovery pass re-queues it after a crash
# Format: duration (30s, 5m, 1h)
# Default: 5m
# Example: 5m
WEBHOOKS__QUEUE__STUCK_PROCESSING_TIMEOUT=5m

# Completed entry retention
# Purpose: Retention period for completed queue rows before the cleanup pass
#   removes them; hours-only form (168h, not 7d)
# Format: duration in hours (168h = 7 days)
# Default: 168h
# Example: 168h
WEBHOOKS__QUEUE__CLEANUP_RETENTION=168h

# =============================================================================
# PING CONFIGURATION
# =============================================================================

# Ping interval
# Purpose: Period of the system:ping heartbeat POST to every webhook
#   registered for that event; the payload is an empty JSON object; a value
#   stored through the Settings API (ping.interval_seconds) overrides this
#   variable when set
# Format: duration (30s, 5m, 1h); 0 disables the event entirely
# Default: 60s
# Example: 60s
PING__INTERVAL=60s
