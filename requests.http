@baseURL=http://localhost:3000
@basicPassword={{$dotenv ASG__PASSWORD}}
@recipientPhone={{$dotenv PHONE}}

# ============================================================
# 1. HEALTH — Unauthenticated
# ============================================================

###
GET {{baseURL}}/health HTTP/1.1

###
GET {{baseURL}}/health/live HTTP/1.1

###
GET {{baseURL}}/health/ready HTTP/1.1

###
GET {{baseURL}}/health/startup HTTP/1.1

###
GET {{baseURL}}/metrics HTTP/1.1

# ============================================================
# 2. CREDENTIALS — Verify auth works
# ============================================================

###
GET {{baseURL}}/api/v1 HTTP/1.1
Authorization: Basic sms:invalid

###
GET {{baseURL}}/api/v1 HTTP/1.1
Authorization: Basic sms:{{basicPassword}}

# ============================================================
# 3. DEVICES
# ============================================================

###
# @name getDevice
GET {{baseURL}}/api/v1/devices HTTP/1.1
Authorization: Basic sms:{{basicPassword}}

###
@deviceID={{getDevice.response.body.$[0].id}}

###
DELETE {{baseURL}}/api/v1/devices/{{deviceID}} HTTP/1.1
Authorization: Basic sms:{{basicPassword}}

# ============================================================
# 4. MESSAGES
# ============================================================

###
# Enqueue -> 202 Accepted + Location header + body id = generated ext_id
# (nanoid; body may carry an explicit id, which is preserved)
# @name postMessage
POST {{baseURL}}/api/v1/messages HTTP/1.1
Authorization: Basic sms:{{basicPassword}}
Content-Type: application/json

{"phoneNumbers":["{{recipientPhone}}"],"textMessage":{"text":"Hello from at-gateway"}}

###
@messageID={{postMessage.response.body.$.id}}

###
# Poll message state by id; expect Pending -> Sent once the worker sends it
GET {{baseURL}}/api/v1/messages/{{messageID}} HTTP/1.1
Authorization: Basic sms:{{basicPassword}}


# --- Get by id ---

###
# Unknown id -> 404
GET {{baseURL}}/api/v1/messages/does-not-exist HTTP/1.1
Authorization: Basic sms:{{basicPassword}}


# --- List ---

###
# List messages; array of MessageState wire objects, total count in X-Total-Count
GET {{baseURL}}/api/v1/messages?limit=10 HTTP/1.1
Authorization: Basic sms:{{basicPassword}}

###
# Filter by state
GET {{baseURL}}/api/v1/messages?state=Sent HTTP/1.1
Authorization: Basic sms:{{basicPassword}}

###
# Sort ascending by created_at (default is -created_at)
GET {{baseURL}}/api/v1/messages?sort=created_at HTTP/1.1
Authorization: Basic sms:{{basicPassword}}


# --- Cancel (DELETE) ---

###
# Cancel a Pending message -> 200 + state Cancelled; if the worker already
# sent it the DELETE answers 400 (message is not pending)
DELETE {{baseURL}}/api/v1/messages/{{messageID}} HTTP/1.1
Authorization: Basic sms:{{basicPassword}}

# ============================================================
# 5. AUTH
# ============================================================

###
# 401 Unauthorized
GET {{baseURL}}/api/v1/messages HTTP/1.1
Authorization: Basic sms:invalid
